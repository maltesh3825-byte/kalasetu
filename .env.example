# =====================================================================
# KalaSetu / KalaKriti - Environment Configuration
# Smart India Hackathon 2026 - Problem Statement SIH26090
# =====================================================================

# 1. Google Gemini AI Vision API Key
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# 2. Database Connection (Local SQLite vs Cloud Supabase PostgreSQL)
# For local offline development, leave DATABASE_URL empty (uses local SQLite artisan_catalog.db).
# For cloud production (Render / Supabase), paste your Supabase connection string:
# DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 3. Security Secrets & Admin Authentication
# Generate a random 64-character hex string for signing session tokens:
# In python: import secrets; print(secrets.token_hex(32))
APP_SECRET_KEY=your_random_64_character_secret_key_here

# Admin Portal Credentials
ADMIN_EMAIL=admin@kalasetu.gov.in
ADMIN_PASSWORD=your_strong_admin_password_here

# 4. Server Binding & Ports
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 5. Gmail / Email OTP Delivery (Optional, for Real Email Delivery)
# To send real verification codes to Gmail inboxes, generate a Google App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
# Or custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail_address@gmail.com
# SMTP_PASS=your_16_character_app_password

